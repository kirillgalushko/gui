{
  "name": "@gui/components",
  "private": true,
  "version": "7.0.3",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "ai": "ts-node src/ai/index.ts",
    "dev": "storybook dev -p 6006",
    "hooks:install": "node ../../scripts/install-hooks.mjs .",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint .",
    "lint:changed": "node ../../scripts/run-changed.mjs --mode lint --project apps/gui",
    "typecheck": "vue-tsc -b --noEmit",
    "typecheck:changed": "node ../../scripts/run-changed.mjs --mode typecheck --project apps/gui",
    "test": "vitest run",
    "test:changed": "node ../../scripts/run-changed.mjs --mode test --project apps/gui",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,mdx}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,css,mdx}\" \"*.{ts,json,md}\"",
    "format:changed": "node ../../scripts/run-changed.mjs --mode format --project apps/gui",
    "unused": "node ../../scripts/find-unused-files.mjs --project apps/gui",
    "check": "npm run format:check && npm run unused && npm run lint:check && npm run typecheck && npm run test",
    "check:changed": "node ../../scripts/run-changed.mjs --mode check --project apps/gui",
    "build": "vite build && vue-tsc -b",
    "release": "npx @gui/release",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@gui/logos": "github:kirillgalushko/gui-logos#v3.0.2",
    "@gui/release": "github:kirillgalushko/gui-release",
    "@gui/sound": "github:kirillgalushko/gui-sound#v1.1.0",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/vue3": "^10.5.7",
    "@storybook/vue3-vite": "^10.5.7",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.9.2",
    "fast-glob": "^3.3.2",
    "inquirer": "^12.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.8.4",
    "storybook": "^10.5.7",
    "typescript": "^5.5.3",
    "vite": "^8.0.16",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^4.1.9",
    "vue": "^3.5.10",
    "vue-tsc": "^2.1.6"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.5",
    "@gui/icons": "github:kirillgalushko/gui-icons#v2.0.2",
    "@number-flow/vue": "^0.5.2",
    "floating-vue": "5.2.2",
    "vue-component-meta": "^3.3.8",
    "vue-sonner": "^2.0.9"
  }
}
