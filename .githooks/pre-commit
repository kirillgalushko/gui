#!/usr/bin/env sh
set -eu

PROJECT_DIR="$(git rev-parse --show-toplevel)"
cd "$PROJECT_DIR"

STAGED_FILES="$(mktemp)"
trap 'rm -f "$STAGED_FILES"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR > "$STAGED_FILES"

npm run format

if [ -s "$STAGED_FILES" ]; then
  xargs -0 git add -- < "$STAGED_FILES"
fi

npm run check
